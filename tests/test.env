# Fake ids so the unit tests can run without a Didit account (npm test loads this file).
# Times in the recorded answers are formatted in UTC, whatever the machine's zone.
TZ=UTC
DIDIT_WORKFLOW_ONBOARDING=00000000-0000-4000-8000-000000000001
DIDIT_WORKFLOW_STEP_UP=00000000-0000-4000-8000-000000000002
