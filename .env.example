# Kestrel - environment variables.
# Copy this file to .env and fill it in. .env is git-ignored.

# Server-side Didit API key (required). Create a free account in the Didit Console
# (https://business.didit.me), open your application and copy its API key.
# A key that starts with sk_test_ belongs to a sandbox application, sk_live_ to a live one.
# This key never reaches the browser.
API_KEY=

# This app's public URL. Callbacks and redirects are built from it.
# Use your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Workflow ids. `npm run setup` creates the 2 workflows below on your application
# and writes the ids here. You can also paste the id of a workflow you built in the Didit Console.
# Account opening: ID check, liveness, face match, AML screening and IP analysis.
DIDIT_WORKFLOW_ONBOARDING=
# Selfie step-up a Travel Rule withdrawal opens: liveness and a face match against the onboarding selfie.
DIDIT_WORKFLOW_STEP_UP=

# Didit Authentication publishable key (optional). A public identifier of your application,
# so it can sit in the page. When it is empty the app keeps its own sign-in form and the
# passkey, Google, Apple and email-code sign-up steps stay hidden.
# It starts with pk_test_ or pk_live_.
DIDIT_PUBLISHABLE_KEY=

# The callback registered for the Authentication application (optional).
# Defaults to NEXT_PUBLIC_SITE_URL + /auth/callback. Add the same URL to the
# application's redirect URIs in the Didit Console.
DIDIT_REDIRECT_URI=http://localhost:3000/auth/callback

# Seconds the Authentication session is cached before it is checked again (optional).
DIDIT_SESSION_CACHE_SECONDS=

# Console deep links (optional). The organization and application ids behind API_KEY.
# When they are empty the app reads them from the API.
DIDIT_CONSOLE_ORG_ID=

# See DIDIT_CONSOLE_ORG_ID.
DIDIT_CONSOLE_APP_ID=
