{
  "name": "crypto-exchange-kyc-travel-rule-nextjs",
  "version": "1.0.0",
  "private": true,
  "description": "Crypto exchange reference app with Didit: KYC and AML before the first deposit, deposits screened by the sending wallet, Travel Rule withdrawals with a selfie step-up. Next.js.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=tests/test.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/setup.mjs"
  },
  "dependencies": {
    "@didit-protocol/auth": "0.1.0",
    "@didit-protocol/auth-nextjs": "0.1.0",
    "@didit-protocol/auth-react": "0.1.0",
    "@didit-protocol/sdk-web": "0.5.0",
    "@didit-protocol/signals": "0.1.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "20.5.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.28",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.3",
    "typescript": "5.5.4"
  }
}
